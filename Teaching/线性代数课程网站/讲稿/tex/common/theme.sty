%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% 定义模式选项（教师、学生、课堂）
% 使用 'ppt', 'handout', 'summary' 作为全局选项
\newif\ifppt
\newif\ifhandout

% 通过选项切换模式
\newcommand{\setmode}[1]{%
  \ifthenelse{\equal{#1}{ppt}}{%
    \ppttrue\handoutfalse
    \newcommand{\pp}{\pause}%
  }{%
    \newcommand{\pp}{}%
    \ifthenelse{\equal{#1}{handout}}{%
      \pptfalse\handouttrue
    }{%
      \PackageError{Invalid mode: #1}{Use 'ppt', or 'handout'.}{}%
     }%
    }%
  }%
% 常用命令
\newcommand{\onlyppt}[1]{\ifppt#1\fi}  % 仅教师模式显示
\newcommand{\onlyhandout}[1]{\ifhandout#1\fi}  % 仅学生模式显示
\newcommand{\onlysummary}[1]{\ifsummary#1\fi} % 仅课堂模式显示
\newcommand{\forhandout}[1]{\ifhandout\green{#1}\fi}  % 学生模式显示
\newcommand{\forsummary}[1]{\ifsummary#1\fi} % 课堂模式显示
\newcommand{\forppt}[1]{\ifppt#1\fi}    % 教师模式显示
